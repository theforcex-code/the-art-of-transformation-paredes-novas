{
 "rewrites": [
  {
   "source": "/api/selecao",
   "destination": "/selecao.json"
  },
  {
   "source": "/",
   "destination": "/apresentacao.html"
  }
 ],
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex"
    }
   ]
  }
 ]
}